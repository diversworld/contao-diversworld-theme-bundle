{% extends "@Contao/page/layout.html.twig" %}

{% block body_content %}
    {% slot header %}
        <header class="header">
            {{ slot() }}
        </header>
    {% endslot %}

    {% slot hero %}
        <section class="hero">
            <div class="container">
                {{ slot() }}
            </div>
        </section>
    {% endslot %}

    {% slot main %}
        <main class="main">
            <div class="container">
                {% set has_left_sidebar = slots.left is defined %}
                {% set has_right_sidebar = slots.right is defined %}
                <div class="row g-4{% if has_left_sidebar %} has-left-sidebar{% endif %}{% if has_right_sidebar %} has-right-sidebar{% endif %}">

                    {% if has_left_sidebar %}
                        <aside class="left col-12 col-lg-3">
                            {{ slots.left }}
                        </aside>
                    {% endif %}

                    <div class="main-content col-12{% if has_left_sidebar and has_right_sidebar %} col-lg-6{% elseif has_left_sidebar or has_right_sidebar %} col-lg-9{% endif %}{% if not has_left_sidebar and not has_right_sidebar %} full-size-layout{% endif %}">
                        {{ slot() }}
                    </div>

                    {% if has_right_sidebar %}
                        <aside class="right col-12 col-lg-3">
                            {{ slots.right }}
                        </aside>
                    {% endif %}

                </div>
            </div>
        </main>
    {% endslot %}

    {% slot footer %}
        <footer class="footer">
            <div class="container">
                {{ slot() }}
            </div>
        </footer>
    {% endslot %}
{% endblock %}
