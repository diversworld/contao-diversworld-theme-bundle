{% extends "@Contao/page/layout.html.twig" %}

{% block body_content %}
    {% slot header %}
        <header class="header">
            <div class="container">
                {{ slot() }}
            </div>
        </header>
    {% endslot %}

    {% slot hero %}
        <section class="hero">
            <div class="container">
                {{ slot() }}
            </div>
        </section>
    {% endslot %}

    {% slot main %}
        <main class="main">
            <div class="container">
                <div class="content-grid">

                    {% if slots.left is defined %}
                        <aside class="left">
                            {{ slots.left }}
                        </aside>
                    {% endif %}

                    <div class="main-content">
                        {{ slot() }}
                    </div>

                    {% if slots.right is defined %}
                        <aside class="right">
                            {{ slots.right }}
                        </aside>
                    {% endif %}

                </div>
            </div>
        </main>
    {% endslot %}

    {% slot footer %}
        <footer class="footer">
            <div class="container">
                {{ slot() }}
            </div>
        </footer>
    {% endslot %}
{% endblock %}
