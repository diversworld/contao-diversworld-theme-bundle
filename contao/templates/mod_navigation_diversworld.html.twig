{% extends "@Contao/frontend_module/_base.html.twig" %}

{% block content %}
    {% if items %}
        <nav
            class="navigation"
            aria-label="{{ ariaLabel ?: 'MSC.headerNavigation'|trans }}"
            itemscope
            itemtype="https://schema.org/SiteNavigationElement"
        >
            <a href="{{ request }}#{{ skipId }}" class="invisible">
                {{ skipNavigation }}
            </a>

            {{ items|raw }}

            <span id="{{ skipId }}" class="invisible"></span>
        </nav>
    {% endif %}
{% endblock %}