{% set wrapper_attributes = attrs(cssID)
    .addClass([class, 'navigation', 'block'])
    .setIfExists('aria-label', ariaLabel|default|insert_tag)
    .setIfExists('style', style)
    .mergeWith(wrapper_attributes|default) %}

<!-- indexer::stop -->
<nav{{ wrapper_attributes }}>
    <div class="container">
        {% if headline|default %}
        <{{ hl }}>{{ headline|insert_tag_html }}</{{ hl }}>
    {% endif %}

    <a href="{{ request }}#{{ skipId }}" class="invisible">{{ skipNavigation }}</a>

    <div class="nav-items">
        {{ items|raw }}
    </div>

    <span id="{{ skipId }}" class="invisible"></span>
    </div>
</nav>
<!-- indexer::continue -->
